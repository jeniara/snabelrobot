[Unit]
Description=Snabelrobot web controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/snabelrobot
ExecStart=/home/pi/snabelrobot/.venv/bin/python /home/pi/snabelrobot/webapp.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

